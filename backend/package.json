{
  "name": "gp-pharmacy-placement-backend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist-server/server/index.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:seed-skills": "tsx prisma/seedSkillModule.ts",
    "db:seed-pharmacy-bank": "tsx prisma/seedPharmacyBank.ts",
    "db:publish-demo": "tsx prisma/publish-demo-test.ts",
    "db:sample-all": "tsx prisma/create-sample-all.ts",
    "db:sample-results": "tsx prisma/seed-sample-results.ts",
    "db:load-500": "tsx prisma/seed-load-500.ts",
    "db:verify-flows": "tsx prisma/seed-load-500.ts --verify-only",
    "check:password": "tsx server/password.check.ts",
    "check:idor": "tsx server/attemptAccess.check.ts",
    "check:permissions": "tsx server/permissions.check.ts",
    "check:session-security": "tsx server/testSession.security.check.ts",
    "check:attempt-lifecycle": "tsx server/attemptLifecycle.check.ts",
    "check:result-import-csv": "tsx server/resultImportCsv.security.check.ts",
    "check:audit-totp": "tsx server/auditTotp.security.check.ts",
    "check:cors": "tsx server/corsOrigins.check.ts",
    "check:security-headers": "tsx server/securityHeaders.check.ts",
    "check:auth-hardening": "tsx server/authHardening.check.ts",
    "db:studio": "prisma studio",
    "vercel:build": "prisma generate && tsc -p tsconfig.json && node scripts/build-demo-db.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "@prisma/client": "^6.8.2",
    "archiver": "^5.3.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.50",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
