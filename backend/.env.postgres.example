# Postgres + capacity defaults for exam day / docker compose.
# 1) Set prisma/schema.prisma provider = "postgresql"
# 2) copy to backend/.env
# 3) npm run db:push && npm run db:seed
# Or: docker compose up --build  then curl http://localhost/api/capacity

DATABASE_URL="postgresql://placement:placement@localhost:5432/placement?schema=public"
JWT_SECRET="local-trial-secret-use-long-random-string-ok"
CLIENT_ORIGIN="http://localhost:5173"
CLIENT_ORIGINS="http://127.0.0.1:5173,http://localhost"
PORT=3001
NODE_ENV=production

TRUST_PROXY=1
EXPECTED_CONCURRENT_USERS=1000
API_REPLICAS=2
DB_POOL_SIZE=15

SESSION_HOURS=2
SESSION_WARN_MINUTES=5
ACCESS_TOKEN_MINUTES=15
RESULTS_AUTO_RELEASE_MINUTES=30

RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_AUTOSAVE_PER_MIN=90
RATE_LIMIT_SUBMIT_PER_MIN=30
RATE_LIMIT_LOGIN_PER_15MIN=120
