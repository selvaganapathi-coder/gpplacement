# Local SQLite (default). Path is relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"
# Production: 32+ random characters. Avoid the words "dev" or "change".
JWT_SECRET="local-trial-secret-use-long-random-string-ok"
CLIENT_ORIGIN="http://localhost:5173"
# Copy this file to backend/.env before running the API.
#
# Production (Render API + Netlify UI) — exact HTTPS origins only, never *:
#   CLIENT_ORIGIN="https://your-site.netlify.app"
# Custom college domain (also exact):
#   CLIENT_ORIGINS="https://placement.gppharmacycollege.com"
# Optional comma-separated extra CORS origins (exact URLs only):
# CLIENT_ORIGINS="https://deploy-preview-1--mysite.netlify.app"
PORT=3001

RESULTS_AUTO_RELEASE_MINUTES=30
# Idle session / refresh cookie lifetime (hours)
SESSION_HOURS=2
SESSION_WARN_MINUTES=5
# Short-lived access JWT in HttpOnly cookie (minutes). Default 15.
ACCESS_TOKEN_MINUTES=15

# bcrypt cost (2^rounds). Default 12. Range 10–15.
# BCRYPT_COST=12

# --- Demo seed (local / trial only) ---
# Local demos: false so changeme123 works without an immediate reset.
# Production: seed scripts always force password change (true implied).
SEED_FORCE_PASSWORD_CHANGE=false

# Production: never seed demo accounts unless this is explicitly true (trial/staging).
# Real college production should leave this unset/false and create users via Admin UI.
# ALLOW_DEMO_SEED=false

# Production: reject login with changeme123 unless this is true (trial only).
# Real production must leave this unset/false.
# ALLOW_DEMO_SEED_PASSWORD=false

# Docker/Render: run prisma seed on container start (requires ALLOW_DEMO_SEED=true in production).
# SEED_ON_START=false

# --- Netlify UI + Render API ---
# On Netlify (build-time): VITE_API_URL=https://your-api.onrender.com
# On Render: CLIENT_ORIGIN=https://your-site.netlify.app
# Optional: PUBLIC_API_URL=https://your-api.onrender.com
# See docs/NETLIFY.md

# --- Email (password reset) ---
# Preferred: SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or: SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM
# Without SMTP, reset links are printed to the API console (dev only).

# Optional dedicated key for TOTP secret encryption (64-char hex or any string).
# If unset, derived from JWT_SECRET. Prefer setting this in production.
# TOTP_ENCRYPTION_KEY=

# Require authenticator (QR) for Admin / Super Admin on every login.
# Leave unset/false for simple email+password demos (2-hour sessions).
# REQUIRE_ADMIN_2FA=true

# For Render / Docker Postgres: set prisma provider to postgresql and use e.g.
# DATABASE_URL="postgresql://placement:placement@localhost:5432/placement?schema=public"

# =============================================================================
# Capacity & load balancing (~1000 concurrent examinees)
# Check overall: GET /api/capacity  ·  readiness: GET /api/ready
# Full guide: docs/CAPACITY.md
# =============================================================================
# Target simultaneous signed-in students (drives WARN/FAIL on /api/capacity).
EXPECTED_CONCURRENT_USERS=1000
# How many API processes sit behind Nginx / Render (set to match real replicas).
API_REPLICAS=1
# Label this process in /api/capacity (docker: api1 / api2).
# INSTANCE_ID=api1
# Trust X-Forwarded-* from the load balancer (required behind Nginx/Render).
# TRUST_PROXY=1
# Prisma Postgres pool size per API process (total ≈ DB_POOL_SIZE × API_REPLICAS).
# DB_POOL_SIZE=20

# Rate limits (per authenticated user, or IP before login) — tune for exam day.
# RATE_LIMIT_GLOBAL_PER_MIN=600
# RATE_LIMIT_LOGIN_PER_15MIN=120
# RATE_LIMIT_SUBMIT_PER_MIN=30
# RATE_LIMIT_AUTOSAVE_PER_MIN=90
# RATE_LIMIT_PROCTOR_PER_MIN=40
# RATE_LIMIT_SENSITIVE_PER_MIN=30
# RATE_LIMIT_PASSWORD_RESET_PER_15MIN=10
# RATE_LIMIT_CHANGE_PASSWORD_PER_15MIN=20
